// catalog-service/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enumerador para diferenciar el origen del contenido
enum TipoContenido {
  ORIGINAL
  TERCEROS
}

// Modelo de Géneros
model Genero {
  id        Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(50)
  
  // Relación implícita con Películas
  peliculas Pelicula[]

  @@map("generos")
}

// Modelo de Películas
model Pelicula {
  id               String        @id @default(uuid()) @db.Uuid
  titulo           String        @db.VarChar(200)
  descripcion      String        @db.Text
  fechaLanzamiento DateTime      @map("fecha_lanzamiento") @db.Date
  duracion         Int
  
  // Rutas de archivos multimedia
  rutaCaratula     String        @map("ruta_caratula") @db.VarChar(500)
  rutaVideo        String        @map("ruta_video") @db.VarChar(500)
  rutaImagenFondo  String        @map("ruta_imagen_fondo") @db.VarChar(500)
  rutaTrailer      String        @map("ruta_trailer") @db.VarChar(500)

  // --- NUEVOS CAMPOS PARA LOS REQUERIMIENTOS ---
  requierePremium  Boolean       @default(false) @map("requiere_premium")
  tipoContenido    TipoContenido @default(ORIGINAL) @map("tipo_contenido")
  creadorId        String?       @map("creador_id") // ID del usuario STUDIO que la subió
  
  // Contadores rápidos para estadísticas
  vistasTotales    Int           @default(0) @map("vistas_totales")
  likesTotales     Int           @default(0) @map("likes_totales")
  dislikesTotales  Int           @default(0) @map("dislikes_totales")

  // Relaciones
  generos          Genero[]

  @@map("peliculas")
}